{
  "name": "stakes-com-mx",
  "private": true,
  "description": "Static HTML site about Stake México, served by Cloudflare Workers static assets",
  "scripts": {
    "build": "python3 build.py",
    "dev": "python3 build.py && node serve.mjs 8080",
    "login": "sh scripts/cf.sh login",
    "whoami": "sh scripts/cf.sh whoami",
    "preview": "python3 build.py && sh scripts/cf.sh dev",
    "deploy": "python3 build.py && sh scripts/cf.sh deploy",
    "cf": "sh scripts/cf.sh"
  }
}
